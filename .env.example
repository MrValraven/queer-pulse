# QueerPulse frontend — build-time environment.
#
# Vite inlines every VITE_* var into the bundle at BUILD time, so these are baked
# into the artifact and cannot be changed afterwards without rebuilding. Nothing
# here may be a secret: anything below is public and readable by anyone.
#
# Copy to `.env` (or `.env.local`) for local development.

# ── Required ─────────────────────────────────────────────────────────────────

# Origin of the QueerPulse NestJS backend — scheme + host, NO trailing slash.
# A production build without this REFUSES TO BOOT (src/shared/api/config.ts),
# rather than silently degrading into mock data presented as real content.
# Production: https://api.queerpulse.com
VITE_API_URL=http://localhost:3000

# ── Optional ─────────────────────────────────────────────────────────────────

# Demo mode — the standalone mock prototype, with no backend and no network.
# Set to exactly `1` to opt in; anything else (including unset) means live mode.
# This is the ONLY way to reach demo mode: it is never inferred from a missing
# or unreachable VITE_API_URL. NEVER set this on a real deployment — it serves
# fabricated content as real community data.
#   VITE_DEMO=1 alone            → standalone prototype, demo locked on
#   VITE_DEMO=1 + VITE_API_URL   → live by default, "Populate platform" in the
#                                  account menu toggles demo on for exploration
# VITE_DEMO=1

# Sentry DSN for error reporting (src/shared/observability/sentry.ts:19).
# Reporting turns on only when DSN + production build + the member's analytics
# consent all hold. Unset = no error reporting.
# NOTE: the Sentry client itself is not installed yet — the module is a no-op
# stub pending spec-01, so setting this has no effect today.
# VITE_SENTRY_DSN=

# Canonical public origin of the frontend, used to build absolute canonical /
# og:url / sitemap URLs (src/shared/seo/seo.data.ts:17). Scheme + host, no
# trailing slash. Independent of the API layer, so meta renders identically in
# demo and live. Unset = falls back to the hardcoded https://queerpulse.com,
# so set it for any deployment served from another origin (staging, previews).
# VITE_SITE_ORIGIN=https://queerpulse.com

# Release identifier attached to Sentry events (sentry.ts:34) — usually the
# commit SHA or a semver tag, injected by CI. Unset = releases aren't tagged.
# Same caveat as VITE_SENTRY_DSN: inert until the Sentry client is installed.
# VITE_RELEASE=
