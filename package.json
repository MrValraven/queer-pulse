{
  "name": "queerpulse",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm lint:a11y && tsc -b && pnpm sitemap && pnpm og && vite build && pnpm prerender:browser && pnpm prerender",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:a11y": "node scripts/report-a11y.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "prerender:browser": "playwright install chromium --only-shell",
    "prerender": "node scripts/prerender.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "og": "node scripts/generate-og-image.mjs",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test",
    "verify": "pnpm lint && pnpm typecheck && pnpm lint:a11y && pnpm test"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@sentry/react": "^8.47.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-virtual": "^3.13.6",
    "@visx/curve": "^4.0.0",
    "@visx/event": "^4.0.0",
    "@visx/responsive": "^4.0.0",
    "@visx/scale": "^4.0.0",
    "@visx/shape": "^4.0.0",
    "@visx/tooltip": "^4.0.0",
    "maplibre-gl": "^5.24.0",
    "motion": "^11.15.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.17.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.12.3",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^3.0.5",
    "axe-core": "^4.10.2",
    "eslint": "^10.3.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^25.0.1",
    "msw": "^2.7.0",
    "prettier": "^3.9.3",
    "sharp": "^0.35.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.0.5",
    "vitest-axe": "^0.1.0",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
